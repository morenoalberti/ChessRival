    "twic:demo": "node scripts/twic-demo.mjs iniciar",
    "twic:cargar": "node scripts/twic-demo.mjs cargar",
    "lumbra:cargar": "node scripts/lumbra-demo.mjs cargar",
    "lumbra:estado": "node scripts/lumbra-demo.mjs estado"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "wrangler": "^4"
  },
  "dependencies": {
    "node-html-parser": "^7"
  }
