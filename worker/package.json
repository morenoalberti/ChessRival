{
  "name": "chessrival-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy --var \"ORIGENES_PERMITIDOS:https://chessrival.net,https://www.chessrival.net\"",
